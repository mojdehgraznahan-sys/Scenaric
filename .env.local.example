# Supabase project settings — Project Settings → API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Audio/video transcription in the Knowledge Base (Gemini's native audio/video
# understanding) — server-side only, never exposed to the browser.
GEMINI_API_KEY=

# Shared secret checked by every src/app/api/cron/*/route.ts — generate a real value
# (e.g. `openssl rand -hex 32`) for .env.local, and set the SAME value in Vercel Project
# Settings → Environment Variables for every deployed environment (this file is never deployed).
CRON_SECRET=

# Weekly scenario digest (AI Analyst tab's "Send weekly scenario digest" toggle,
# src/app/api/cron/weekly-digest/route.ts) — resend.com API key + a "from" address on a
# domain verified in your Resend account. Server-side only, never exposed to the browser.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
