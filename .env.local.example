# Supabase project settings — Project Settings → API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Audio/video transcription in the Knowledge Base (Gemini's native audio/video
# understanding) — server-side only, never exposed to the browser.
GEMINI_API_KEY=

# Shared secret checked by src/app/api/cron/indicators-monitor/route.ts — generate a real value
# (e.g. `openssl rand -hex 32`) for .env.local, and set the SAME value in Vercel Project
# Settings → Environment Variables for every deployed environment (this file is never deployed).
CRON_SECRET=
